DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=invoice_generation

# Seeded on first startup if no matching user exists
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=Admin@12345

# Frontend on another PC: list that machine's Vite origins (cookie auth cannot use *).
# Example: FE opened as http://localhost:5173 on other PC, or http://<FE-LAN-IP>:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Vite React app (repo root): leave VITE_API_BASE_URL empty to use the Vite /api proxy.
# Put these in `.env.local` (preferred) or `.env`:
# VITE_API_BASE_URL=
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# PDF export on Linux/AWS (LibreOffice). Optional if soffice is on PATH.
# SOFFICE_PATH=/usr/bin/soffice
