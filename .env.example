DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=invoice_generation

# Seeded on first startup if no matching user exists
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=Admin@12345

# Vite / other frontends that call this API (comma-separated, no spaces required)
# Cookie auth cannot use *; list each FE origin explicitly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# PDF export on Linux/AWS (LibreOffice). Optional if soffice is on PATH.
# SOFFICE_PATH=/usr/bin/soffice
